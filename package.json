{
  "name": "jarai",
  "productName": "jarai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "JarAI — l'assistente legale di Claude Code per lo studio, senza mai mostrare codice.",
  "author": "Studio",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.272",
    "@kenjiuno/msgreader": "^1.28.0",
    "docx": "^9.7.1",
    "dommatrix": "^1.0.3",
    "mammoth": "^1.12.3",
    "node-forge": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/word-extractor": "^1.0.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.jarai.app",
    "productName": "jarai",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "**/node_modules/@napi-rs/canvas-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/trascrivi.py",
        "to": "resources/trascrivi.py"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "jarai"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    }
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-win32-x64": "^0.3.272"
  }
}
