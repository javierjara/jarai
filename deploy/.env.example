# Copiare in /srv/jarai/<studio>/.env  (chmod 600, chown jarai:jarai)
# Commenti solo su righe proprie: niente "# ..." dopo un valore.

STUDIO=molfino

# Output di: id -u jarai  /  id -g jarai
JARAI_UID=
JARAI_GID=

# Record DNS su Vercel (team javitek): A + AAAA verso il server botcom.
JARAI_URL_PUBBLICO=https://molfino.jarai.botcom.it

# Licenza JarAI: il server parla con Claude attraverso jarai-proxy.
JARAI_LICENZA=jarai_...

# Chiave per cifrare jarai.db e le sessioni a riposo. In produzione NON va
# scritta qui in chiaro: la fornisce lo studio all'avvio (README, Cifratura).
# JARAI_CHIAVE_DATI=
